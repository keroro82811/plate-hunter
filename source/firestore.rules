rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User private data: each authenticated user can only access their own profile and all subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User subcollections (e.g. plates, settings, backups)
      match /{allUserPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
